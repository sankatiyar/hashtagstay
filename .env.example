# ---------------------------------------------------------------------------
# #HashtagStay environment template
#
# Copy to `.env.local` and fill in. `.env.local` is gitignored — never commit
# real credentials. Validated by src/lib/env.ts, which fails fast on startup.
#
# Values marked PENDING gate a feature behind vendor procurement (see
# docs/vendors.md). The app builds and runs without them; the feature that needs
# one throws a named error until it is set.
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- Database (Supabase Postgres) ------------------------------------------
# DATABASE_URL: runtime connection. Use the TRANSACTION pooler (port 6543) —
#   Supabase dashboard > Connect > Transaction pooler. Prepared statements are
#   disabled for this in src/lib/db/index.ts.
# DATABASE_URL_DIRECT: migrations only. Use the DIRECT connection (port 5432).
#   DDL and advisory locks do not work over the transaction pooler.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres"
DATABASE_URL_DIRECT="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres"

# --- Supabase ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
# Publishable/anon key. Public by design — protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# Secret (service_role) key. Bypasses RLS. Server-only — NEVER prefix NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=""

# --- Auth -------------------------------------------------------------------
# Generate: openssl rand -base64 32   (or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# --- Site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_GA4_MEASUREMENT_ID=""

# --- Payments: Razorpay (PENDING KYC) ---------------------------------------
# Phase 1 collects ONLY the facilitation fee from the resident. Rent and deposit
# are paid resident -> host off-platform, so no Route/split settlement here.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# --- Telephony: Exotel / Ozonetel (PENDING KYC + number provisioning) -------
# Number MASKING is mandatory, not optional: it is what prevents a host's number
# reaching a resident and the booking happening off-platform (revenue leakage).
TELEPHONY_PROVIDER="none"   # exotel | ozonetel | none
TELEPHONY_API_KEY=""
TELEPHONY_API_TOKEN=""
TELEPHONY_ACCOUNT_SID=""
TELEPHONY_CALLER_ID=""
TELEPHONY_WEBHOOK_SECRET=""

# --- WhatsApp Business via BSP (PENDING Meta business verification) ---------
# Long lead time: business verification plus per-template approval.
WHATSAPP_PROVIDER="none"    # aisensy | interakt | gupshup | none
WHATSAPP_API_KEY=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_WEBHOOK_SECRET=""

# --- SMS / OTP (PENDING DLT registration) -----------------------------------
# Indian transactional SMS also requires TRAI DLT template registration.
SMS_PROVIDER="none"         # msg91 | none
SMS_API_KEY=""
SMS_OTP_TEMPLATE_ID=""
SMS_SENDER_ID=""

# --- Email ------------------------------------------------------------------
EMAIL_PROVIDER="none"       # resend | ses | none
EMAIL_API_KEY=""
EMAIL_FROM="no-reply@hashtagstay.example"

# --- Jobs / durable SLA timers ----------------------------------------------
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# --- Observability ----------------------------------------------------------
SENTRY_DSN=""

# --- Compliance / business config -------------------------------------------
# Our own GSTIN — required on every tax invoice we issue. M4 invoicing refuses
# to run without this and COMPANY_STATE_CODE.
COMPANY_GSTIN=""
COMPANY_STATE_CODE=""       # 2-digit GST state code of our place of supply

# Stamped onto every consent record. Bump when the privacy notice changes so we
# never retroactively claim consent under terms the user never saw (DPDP Act).
PRIVACY_POLICY_VERSION="2026-09-01"

# --- Demo deployment ---------------------------------------------------------
# DEMO_MODE=true lets a production build use the test vendor adapters (outbox
# messages, on-screen OTP codes, test payments, TEST invoice series) so the whole
# journey can be clicked through before vendors are procured. Every such screen
# is labelled. NEVER set it on the real launch.
DEMO_MODE="false"

# Bearer token Vercel Cron sends to /api/cron/run. Generate like AUTH_SECRET.
CRON_SECRET=""

# Seed only (npm run db:seed). Staff logins are created with this password in a
# demo or production database; without it they are skipped. Min 12 characters.
# Locally, a dev password is used when this is blank.
SEED_STAFF_PASSWORD=""

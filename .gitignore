# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — secrets never get committed, but the template must be
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# next.js 16 writes dev output separately from build output
/.next/dev/
/.next-profiles/

# local toolchain / scratch
/.local/
*.local.log

# per-developer Claude Code settings (shared config belongs in .claude/settings.json)
.claude/settings.local.json

# verification evidence and ad-hoc exports (may contain PII — never commit)
/tmp/
/exports/
